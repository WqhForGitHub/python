# 开发环境配置示例
# 使用方法：复制本文件为 .env 并根据需要修改，生产环境务必通过环境变量注入真实值。

# 调试模式（生产环境必须为 False）
DEBUG=True

# Django 密钥（生产环境请使用足够长的随机字符串）
SECRET_KEY=django-insecure-demo-template-project-change-this-in-production-1234567890

# 允许访问的主机名（多个用逗号分隔），生产环境应改为具体域名
ALLOWED_HOSTS=*

# 数据库连接地址（默认使用 SQLite，可切换为 PostgreSQL）
# 示例 PostgreSQL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3
