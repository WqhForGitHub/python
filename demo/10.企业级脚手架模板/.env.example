# 拷贝为 .env 后修改。Docker Compose 中已通过 environment 覆盖。

# 应用
APP_NAME=企业级脚手架模板
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库（PostgreSQL；本地无 PG 时可改为 sqlite+aiosqlite:///./scaffold.db）
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/scaffold

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# 初始管理员
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin123456
INITIAL_ADMIN_EMAIL=admin@example.com
